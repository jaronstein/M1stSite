<!DOCTYPE html>
<html lang="en">
<head>
  {%- set tl = site.brand == "throughline" -%}
  {%- set defaultTitle = "Throughline CR: the page says what the ad said" if tl else "Mobile1st is now Throughline" -%}
  {%- set defaultDesc = "Throughline rebuilds the page each ad and email sends people to so it says what the ad said, then tests it against your original." if tl else "Mobile1st is now Throughline. We rebuild the landing page each ad sends people to so it says what the ad said, and test it against the original." -%}
  {%- set defaultImage = site.url + ("/img/og-throughline.png" if tl else "/img/og-default.png") -%}
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or defaultTitle }}</title>
  <meta name="description" content="{{ description or defaultDesc }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  <link rel="alternate" type="application/atom+xml" href="https://throughlinecr.ai/feed.xml" title="The E-Commerce Director's Cut" />
  <link rel="llms" href="{{ site.url }}/llms.txt" />

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:title" content="{{ title or defaultTitle }}" />
  <meta property="og:description" content="{{ description or defaultDesc }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:type" content="{% if date %}article{% else %}website{% endif %}" />
  <meta property="og:image" content="{{ og_image or defaultImage }}" />
  {% if date %}<meta property="article:published_time" content="{{ date | htmlDateString }}" />{% endif %}
  {% if author %}<meta property="article:author" content="{{ author }}" />{% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title or defaultTitle }}" />
  <meta name="twitter:description" content="{{ description or defaultDesc }}" />
  <meta name="twitter:image" content="{{ og_image or defaultImage }}" />

  <!-- Organization schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Throughline CR",
    "alternateName": "Mobile1st",
    "url": "https://throughlinecr.ai",
    "logo": "https://throughlinecr.ai/img/throughline-mark.png",
    "description": "Throughline rebuilds the landing page each ad and email sends people to so it says what the ad said, then tests it against the original.",
    "founder": { "@type": "Person", "name": "Justin Aronstein" },
    "contactPoint": { "@type": "ContactPoint", "email": "justin@mobile1st.com", "contactType": "customer service" },
    "sameAs": [
      "https://mobile1st.com",
      "https://www.linkedin.com/company/mobile1st/",
      "https://podcasts.apple.com/podcast/id1821016403",
      "https://open.spotify.com/show/5nJRi9PbWWU7BRUpqO9jJT",
      "https://feeds.castos.com/oz5z5"
    ]
  }
  </script>

  <!-- Person schema — Justin Aronstein -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Justin Aronstein",
    "url": "https://mobile1st.com/about/",
    "jobTitle": "Founder",
    "worksFor": { "@type": "Organization", "name": "Throughline CR", "url": "https://throughlinecr.ai" },
    "description": "Founder of Throughline (formerly Mobile1st). Host of the Checkin to Checkout podcast.",
    "sameAs": [
      "https://www.linkedin.com/in/justinaronstein/",
      "https://throughlinecr.ai/podcast/"
    ]
  }
  </script>

  {% if preload_image %}<link rel="preload" as="image" href="{{ preload_image }}" type="image/webp" fetchpriority="high" media="(min-width: 769px)" />{% endif %}

  <!-- Poppins — self-hosted, preloaded -->
  <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/poppins-500.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />

  <!--
    Obviously font (OH no Type Co) — commercial license required.
    Purchase at: https://ohnotype.co/fonts/obviously
    After purchasing, place font files in src/fonts/ and uncomment the @font-face
    block in src/css/style.css
  -->

  <style>{% inlineCSS %}</style>
  {% if tl %}<link rel="icon" href="/img/throughline-favicon.svg" type="image/svg+xml" />{% else %}<link rel="icon" href="/img/favicon.ico" />{% endif %}

</head>
<body{% if tl %} class="tl"{% endif %}>

  {% if tl %}
  <header class="site-header tl-header">
    <div class="container">
      <a class="tl-mark" href="https://throughlinecr.ai/" aria-label="Throughline CR by Mobile1st, home">
        <span class="tl-mark__name" aria-hidden="true">Throughline<b>CR</b><sup>™</sup></span>
        <span class="tl-mark__rule" aria-hidden="true"></span>
        <span class="tl-mark__by" aria-hidden="true">BY MOBILE1ST</span>
      </a>
      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav class="site-nav">
        <a href="https://throughlinecr.ai/how-it-works">How it works</a>
        <a href="https://throughlinecr.ai/index">Message Match Index</a>
        <a href="https://throughlinecr.ai/docs">Docs</a>
        <a href="/news/">News</a>
        <a href="/podcast/">Podcast</a>
        <a href="https://throughlinecr.ai/login">Sign in</a>
        <a href="https://throughlinecr.ai/report" class="nav-cta">Get my gap report</a>
      </nav>
    </div>
  </header>
  {% else %}
  <a class="m1-move-banner" href="https://throughlinecr.ai/">Mobile1st is now ThroughlineCR™. Visit throughlinecr.ai →</a>
  <header class="site-header">
    <div class="container">
      <a href="/" class="logo"><img src="/img/logo.png" alt="Mobile1st" height="48" /></a>
      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav class="site-nav">
        <a href="https://throughlinecr.ai/how-it-works">Throughline</a>
        <a href="/#products">Products</a>
        <a href="/#results">Results</a>
        <a href="https://throughlinecr.ai/news/">E-comm Director's Cut</a>
        <a href="https://throughlinecr.ai/podcast/">Podcast</a>
        <a href="/quiz/" class="nav-cta">Where Should I Start? →</a>
      </nav>
    </div>
  </header>
  {% endif %}

  <main>
    {{ content | safe }}
  </main>

  {% if tl %}
  <footer class="site-footer tl-footer">
    <div class="container">
      <div class="tl-footer__row">
        <span>Throughline CR by Mobile1st</span>
        <nav aria-label="Footer">
          <a href="https://throughlinecr.ai/signup">Sign up</a>
          <a href="https://throughlinecr.ai/report">Free ad gap report</a>
          <a href="https://throughlinecr.ai/how-it-works">How it works</a>
          <a href="https://throughlinecr.ai/docs">Documentation</a>
          <a href="https://throughlinecr.ai/index">Message Match Index</a>
          <a href="/news/">News</a>
          <a href="/podcast/">Podcast</a>
          <a href="https://throughlinecr.ai/privacy">Privacy</a>
          <a href="https://throughlinecr.ai/terms">Terms</a>
          <a href="https://throughlinecr.ai/login">Sign in</a>
        </nav>
      </div>
      <p class="tl-footer__copy">&copy; {{ "" | currentYear }} Mobile1st. All rights reserved.</p>
    </div>
  </footer>
  {% else %}
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <img src="/img/logo.png" alt="Mobile1st" height="32" class="footer-logo" />
          <p>Mobile1st is now Throughline: landing pages that say what the ad said.</p>
        </div>
        <div class="footer-links">
          <a href="https://throughlinecr.ai/how-it-works">Throughline</a>
          <a href="/#products">Products &amp; Pricing</a>
          <a href="/#results">Results</a>
          <a href="/#fit">Who We Work With</a>
          <a href="https://throughlinecr.ai/news/">Director's Cut</a>
          <a href="/about/">About</a>
        </div>
        <div class="footer-cta">
          <p>See what your ads promise that your pages don't.</p>
          <a href="https://throughlinecr.ai/report" class="btn btn-primary">Get my gap report →</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {{ "" | currentYear }} Mobile1st. All rights reserved.</p>
      </div>
    </div>
  </footer>
  {% endif %}

  <!-- Booking Modal -->
  <div id="booking-modal" class="booking-modal-overlay" role="dialog" aria-modal="true" aria-label="Book a time to talk">
    <div class="booking-modal">
      <div class="booking-modal-header">
        <h2>Book a Time to Talk</h2>
        <button class="booking-modal-close" aria-label="Close">&times;</button>
      </div>
      <!-- Google Calendar Appointment Scheduling begin -->
      <iframe data-src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ17zgsYfWZ2Wd4knXkXBfCtc1Iz8xpg8UwQ8v04yrIfOyiw24yQpQT_IQWYSkI2GvWs1ekTjM_Z?gv=true" width="100%" height="600" frameborder="0"></iframe>
      <!-- end Google Calendar Appointment Scheduling -->
    </div>
  </div>

  <!-- Podcast Guest Modal -->
  <div id="podcast-modal" class="booking-modal-overlay" role="dialog" aria-modal="true" aria-label="Apply to be a podcast guest">
    <div class="booking-modal">
      <div class="booking-modal-header">
        <h2>Apply to Be a Guest</h2>
        <button class="booking-modal-close" aria-label="Close">&times;</button>
      </div>
      <!-- Google Calendar Appointment Scheduling begin -->
      <iframe data-src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ3c_NZNJoZsKaaX9dU_JrxaZlGsWSHrv8b4HU7PZXIRp_8UzHbVW3ZNx7CEy6ofKlSjyYiily12?gv=true" style="border: 0" width="100%" height="600" frameborder="0"></iframe>
      <!-- end Google Calendar Appointment Scheduling -->
    </div>
  </div>

  <script>{% inlineJS "nav.js" %}</script>

  <!-- Leadfeeder -->
  <script>(function(ss,ex){ window.ldfdr=window.ldfdr||function(){(ldfdr._q=ldfdr._q||[]).push([].slice.call(arguments));}; (function(d,s){ fs=d.getElementsByTagName(s)[0]; function ce(src){ var cs=d.createElement(s); cs.src=src; cs.async=1; fs.parentNode.insertBefore(cs,fs); }; ce('https://sc.lfeeder.com/lftracker_v1_'+ss+(ex?'_'+ex:'')+'.js'); })(document,'script'); })('p1e024BoolKaGB6d');</script>

  <!-- REB2B -->
  <script>!function(key){if(window.reb2b)return;window.reb2b={loaded:true};var s=document.createElement("script");s.async=true;s.src="https://b2bjsstore.s3.us-west-2.amazonaws.com/b/"+key+"/"+key+".js.gz";document.getElementsByTagName("script")[0].parentNode.insertBefore(s,document.getElementsByTagName("script")[0]);}("Q1N5W0H9J7O5");</script>

  <!-- Apollo -->
  <script>function initApollo(){var n=Math.random().toString(36).substring(7),o=document.createElement("script");
o.src="https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache="+n,o.async=!0,o.defer=!0,
o.onload=function(){window.trackingFunctions.onLoad({appId:"6acd48b6c855e00014d35de6"})},
document.head.appendChild(o)}initApollo();</script>
</body>
</html>
